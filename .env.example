# Copy to .env and fill in. .env is gitignored and must stay that way.
# Supabase -> Project Settings -> API

VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Nothing else belongs here. Email keys, calling keys and anything else secret
# go in Supabase -> Edge Functions -> Secrets, where the browser cannot read them.
